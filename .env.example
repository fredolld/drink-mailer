# 複製成 .env.local 供本機開發；正式環境請到 Vercel → Settings → Environment Variables 設定同名變數。

# --- Google 試算表 ---
# 整份 service account 金鑰 JSON（與 Colab Secrets 的 GSPREAD_KEY 相同），貼成一行
GOOGLE_SERVICE_ACCOUNT_KEY=
# 試算表網址 /d/ 與 /edit 之間那一段
SPREADSHEET_ID=
# 明細分頁；留空則依台北時間年份自動使用 RawData_<年份>
SHEET_RAWDATA=

# --- 寄信（SMTP）---
SMTP_HOST=
SMTP_PORT=587
# 使用 465/SSL 時設為 true
SMTP_SECURE=false
# 伺服器不需驗證時這兩項留空
SMTP_USER=
SMTP_PASS=
# 寄件者，例如：飲料開團 <someone@example.com>
MAIL_FROM=
